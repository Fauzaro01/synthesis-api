<% /* Flash messages (success_msg, error_msg, error) */ %>
<% if (typeof success_msg !== 'undefined' && success_msg.length) { %>
  <% success_msg.forEach(function(m){ %>
    <div class="mb-4 p-4 rounded-lg bg-green-50 border-l-4 border-green-400 text-green-800 flex justify-between items-start" role="status">
      <div class="mr-4">
        <strong class="block font-medium">Success</strong>
        <div class="text-sm"><%= m %></div>
      </div>
      <button type="button" class="text-green-600 hover:text-green-800 text-sm" onclick="this.closest('div[role=status]').remove()">Close</button>
    </div>
  <% }) %>
<% } %>

<% if (typeof error_msg !== 'undefined' && error_msg.length ) { %>
  <% error_msg.forEach(function(m){ %>
    <div class="mb-4 p-4 rounded-lg bg-red-50 border-l-4 border-rose-400 text-rose-800 flex justify-between items-start" role="alert">
      <div class="mr-4">
        <strong class="block font-medium">Error</strong>
        <div class="text-sm"><%= m %></div>
      </div>
      <button type="button" class="text-rose-600 hover:text-rose-800 text-sm" onclick="this.closest('div[role=alert]').remove()">Close</button>
    </div>
  <% }) %>
<% } %>

<% if (typeof error !== 'undefined' && error != '') { %>
  <div class="mb-4 p-4 rounded-lg bg-red-50 border-l-4 border-rose-400 text-rose-800 flex justify-between items-start" role="alert">
    <div class="mr-4">
      <strong class="block font-medium">Error</strong>
      <div class="text-sm"><%= error %></div>
    </div>
    <button type="button" class="text-rose-600 hover:text-rose-800 text-sm" onclick="this.closest('div[role=alert]').remove()">Close</button>
  </div>
<% } %>