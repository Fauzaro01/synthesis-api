<% if (error != '') { %>
    <div class="alert alert-danger"><%- error %></div>
<% } %>

<% /* Validation / errors list */ %>
<% if (typeof errors !== 'undefined' && errors && errors.length) { %>
  <div class="mb-4 p-4 rounded-lg bg-rose-50 border border-rose-100 text-rose-800">
    <div class="font-medium">Please fix the following:</div>
    <ul class="mt-2 list-disc list-inside text-sm space-y-1">
      <% errors.forEach(function(err){ %>
        <li><%= (err.msg || err.message || err).toString() %></li>
      <% }) %>
    </ul>
  </div>
<% } %>
