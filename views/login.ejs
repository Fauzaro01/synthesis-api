<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login | Synthesis-Team</title>
    <!-- Use compiled Tailwind CSS -->
    <link href="/css/style.css" rel="stylesheet" />
    <link rel="shortcut icon" type="image/x-icon" href="/images/favicon.png" />
  </head>
  <body class="min-h-screen bg-slate-50 dark:bg-slate-900 flex items-center justify-center">
    <main class="w-full max-w-md p-6 bg-white dark:bg-slate-800 rounded-lg shadow-lg">
      <div class="text-center">
        <img src="/images/icon.svg" alt="logo" class="mx-auto h-14 w-14 mb-4" />
        <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Sign In</h1>
        <p class="text-sm text-slate-500 dark:text-slate-300 mt-1">Access your API dashboard and keys</p>
      </div>

      <div class="mt-4">
        <%- include('layouts/msg')  %>
        <%- include('layouts/errors')  %>
      </div>

      <form method="post" action="/auth/login" class="mt-6 space-y-4">
        <label class="block">
          <span class="text-sm text-slate-700 dark:text-slate-200">Username</span>
          <input type="text" name="username" required class="mt-1 block w-full rounded-md border-slate-200 dark:border-slate-700 bg-transparent px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </label>

        <label class="block relative">
          <span class="text-sm text-slate-700 dark:text-slate-200">Password</span>
          <input id="password" type="password" name="password" required class="mt-1 block w-full rounded-md border-slate-200 dark:border-slate-700 bg-transparent px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500 pr-10" />
          <button type="button" onclick="togglePassword()" class="absolute right-2 top-9 text-slate-400 hover:text-slate-600 dark:hover:text-slate-300 text-sm">Show</button>
        </label>

        <div>
          <%- recaptcha %>
        </div>

        <div class="flex items-center justify-between text-sm">
          <div>
            <span class="text-slate-600 dark:text-slate-400">Don't have an account?</span>
            <a href="/auth/register" class="text-indigo-600 dark:text-indigo-400 ml-2">Register</a>
          </div>
          <a href="/auth/forgot" class="text-slate-600 dark:text-slate-400">Forgot?</a>
        </div>

        <button type="submit" class="w-full py-2 rounded-md bg-gradient-to-r from-indigo-600 to-cyan-500 text-white font-medium">Login</button>

        <div class="mt-4 text-center text-xs text-slate-400">
          Synthesis-Team • REST API for developers
        </div>
      </form>
    </main>

    <script>
      function togglePassword(){
        const p = document.getElementById('password');
        if(!p) return;
        if(p.type === 'password'){ p.type = 'text'; }
        else { p.type = 'password'; }
      }
    </script>
  </body>
</html>
