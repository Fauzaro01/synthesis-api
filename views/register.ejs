<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register | Synthesis-Team</title>
    <link href="/css/style.css" rel="stylesheet" />
    <link rel="shortcut icon" type="image/x-icon" href="/images/favicon.png" />
  </head>
  <body class="min-h-screen bg-slate-50 dark:bg-slate-900 flex items-center justify-center">
    <main class="w-full max-w-md p-6 bg-white dark:bg-slate-800 rounded-lg shadow-lg">
      <div class="text-center">
        <img src="/images/icon.svg" alt="logo" class="mx-auto h-14 w-14 mb-4" />
        <h1 class="text-2xl font-semibold text-slate-900 dark:text-slate-100">Create account</h1>
        <p class="text-sm text-slate-500 dark:text-slate-300 mt-1">Register to obtain API keys and manage usages</p>
      </div>

      <div class="mt-4">
        <%- include('layouts/msg')  %>
        <%- include('layouts/errors')  %>
      </div>

      <form method="post" action="/auth/register" class="mt-6 space-y-4">
        <label class="block">
          <span class="text-sm text-slate-700 dark:text-slate-200">Full name</span>
          <input type="text" name="name" required class="mt-1 block w-full rounded-md border-slate-200 dark:border-slate-700 bg-transparent px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </label>

        <label class="block">
          <span class="text-sm text-slate-700 dark:text-slate-200">Username</span>
          <input type="text" name="username" required class="mt-1 block w-full rounded-md border-slate-200 dark:border-slate-700 bg-transparent px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </label>

        <label class="block">
          <span class="text-sm text-slate-700 dark:text-slate-200">Email (optional)</span>
          <input type="email" name="email" class="mt-1 block w-full rounded-md border-slate-200 dark:border-slate-700 bg-transparent px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </label>

        <label class="block">
          <span class="text-sm text-slate-700 dark:text-slate-200">Password</span>
          <input type="password" name="password" required class="mt-1 block w-full rounded-md border-slate-200 dark:border-slate-700 bg-transparent px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
        </label>

        <div>
          <%- recaptcha %>
        </div>

        <div class="flex items-center justify-between text-sm">
          <span class="text-slate-600 dark:text-slate-400">Already have an account?</span>
          <a href="/auth/login" class="text-indigo-600 dark:text-indigo-400 ml-2">Sign in</a>
        </div>

        <button type="submit" class="w-full py-2 rounded-md bg-indigo-600 text-white font-medium">Create account</button>

        <div class="mt-4 text-center text-xs text-slate-400">
          By registering you agree to use the API responsibly. Rate limits apply.
        </div>
      </form>
    </main>
  </body>
</html>
